#
# Build config shared by every device group in this repo — HNAT offload,
# toolchain and package selection; everything that does not depend on which
# SoC group is being built.
#
# prepare-build.sh concatenates this with devices/<group>/config (that file
# wins on any symbol set in both) and runs `make defconfig`.
#

## Target Platform
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y

# Keep initramfs images: on these NAND boards the *-recovery.itb /
# initramfs-factory.ubi artifacts are the recovery path via U-Boot's web UI.

## Compiler and Toolchain Optimization
CONFIG_BINUTILS_USE_VERSION_2_45=y
CONFIG_DEVEL=y
CONFIG_GCC_USE_VERSION_15=y
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -mcpu=cortex-a53+crc+crypto"
CONFIG_TARGET_OPTIONS=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_USE_GC_SECTIONS=y
CONFIG_USE_LTO=y
CONFIG_USE_MOLD=y
CONFIG_ZLIB_OPTIMIZE_SPEED=y
# CONFIG_CCACHE is not set

## Hardening build options
CONFIG_GCC_DEFAULT_PIE=y
CONFIG_GCC_DEFAULT_SSP=y
CONFIG_PKG_CHECK_FORMAT_SECURITY=y
CONFIG_PKG_ASLR_PIE_ALL=y
CONFIG_PKG_CC_STACKPROTECTOR_ALL=y
CONFIG_KERNEL_CC_STACKPROTECTOR_STRONG=y
CONFIG_PKG_FORTIFY_SOURCE_3=y
CONFIG_PKG_RELRO_FULL=y
CONFIG_USE_SECCOMP=y

## MTK HNAT hardware offload (PPE). The tree packages the driver as
## kmod-mediatek_hnat (KCONFIG NET_MEDIATEK_HNAT=m, installs mtkhnat.ko).
## Flipping the subtarget kernel config to =y does not survive: the kernel
## config generator forces the KCONFIG symbols of unselected kmods off, so
## the module has to be selected here. It has no AUTOLOAD; the overlay
## files/etc/modules.d/90-mtkhnat loads it at boot (hook_toggle defaults
## to 1 in the driver). hnat-detect (DEFAULT_PACKAGES) then registers the
## wan/lan netdevs on ifup.
CONFIG_PACKAGE_kmod-mediatek_hnat=y
##
## Runtime pieces ride along from the tree's defaults: hnat-detect (auto
## enable/disable around firewall reloads), mtk-smp (IRQ/RPS affinity) and
## l1util are in the filogic target's DEFAULT_PACKAGES.
##
## Multicast routing so the PPE can offload IPTV/IGMP flows when configured.
CONFIG_KERNEL_IP_MROUTE=y
CONFIG_KERNEL_IPV6_MROUTE=y

## LuCI + web UI over HTTPS
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-app-firewall=y

## IPv6 / MAP-E (OCN Virtual Connect): map package + LuCI protocol support.
CONFIG_PACKAGE_map=y
CONFIG_PACKAGE_luci-proto-ipv6=y

## Diagnostics and utilities
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
